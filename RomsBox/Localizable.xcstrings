          }
        }
      }
    },
    "D-pad or left stick: browse. Confirm: play. Y / Triangle: favorite. LB / RB: previous or next system. Menu / Start: Big Box.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Croix ou stick gauche : parcourir. Valider : jouer. Y / Triangle : favori. LB / RB : système précédent ou suivant. Menu / Start : Big Box."
          }
        }
      }
    },
