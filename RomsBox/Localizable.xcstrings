      }
    },
    "Cores and emulators you installed yourself are detected too. Settings › Emulators also checks for core updates.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les cœurs et émulateurs que vous avez installés vous-même sont aussi détectés. Réglages › Émulateurs vérifie aussi les mises à jour des cœurs."
          }
        }
      }
    },
