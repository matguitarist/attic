    "RomsBox Help": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aide RomsBox"
          }
        }
      }
    },
    "RomsBox can fetch descriptions, release dates and artwork from ScreenScraper or TheGamesDB. ScreenScraper matches games exactly by file; TheGamesDB searches by title.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "RomsBox peut récupérer descriptions, dates de sortie et illustrations depuis ScreenScraper ou TheGamesDB. ScreenScraper identifie les jeux exactement par fichier ; TheGamesDB cherche par titre."
          }
        }
      }
    },
    "RomsBox downloads emulators from their official sources only: RetroArch and its cores from libretro's buildbot, standalone emulators from their own release pages. Each system's page lists the recommended emulator first.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "RomsBox télécharge les émulateurs uniquement depuis leurs sources officielles : RetroArch et ses cœurs depuis le buildbot de libretro, les émulateurs autonomes depuis leur propre page de versions. La page de chaque système indique d’abord l’émulateur recommandé."
          }
        }
      }
    },
    "RomsBox installs blueMSX's machine and database files into the BIOS folder with the core.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "RomsBox installe les fichiers de machines et de base de données de blueMSX dans le dossier BIOS avec le cœur."
          }
        }
      }
    },
    "RomsBox reads ROMs folders organized the way Batocera, RetroBat and ES-DE do it: one subfolder per system, named after the system (snes, megadrive, neogeo…). Each system's help page lists the folder names it recognizes.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "RomsBox lit les dossiers de ROMs organisés comme Batocera, RetroBat et ES-DE : un sous-dossier par système, nommé d’après le système (snes, megadrive, neogeo…). La page d’aide de chaque système indique les noms de dossier reconnus."
          }
        }
      }
    },
    "Romsets must match FinalBurn Neo's version (1.0.0.03). Sets from other versions or from another emulator may fail to load.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les romsets doivent correspondre à la version de FinalBurn Neo (1.0.0.03). Ceux d’autres versions ou d’un autre émulateur peuvent ne pas se charger."
          }
        }
      }
    },
    "Running…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En cours…"
          }
        }
      }
    },
    "Same as title": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Comme le titre"
          }
        }
      }
    },
    "Save": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrer"
          }
        }
      }
    },
    "Save Current Settings as Profile…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrer les réglages actuels comme profil…"
          }
        }
      }
    },
    "Save Profile": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrer le profil"
          }
        }
      }
    },
    "Save your setup as a profile to switch back to it later; profiles are kept in the Emulation folder.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrez votre configuration comme profil pour y revenir plus tard ; les profils sont conservés dans le dossier Emulation."
          }
        }
      }
    },
    "Saved profiles are kept in the Emulation folder.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les profils enregistrés sont conservés dans le dossier Emulation."
          }
        }
      }
    },
    "Saving with an existing profile's name replaces it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrer sous le nom d’un profil existant le remplace."
          }
        }
      }
    },
    "Scan Now": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyser maintenant"
          }
        }
      }
    },
    "Scanning…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Analyse…"
          }
        }
      }
    },
    "Scrape %lld Missing From": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Récupérer les %lld manquants depuis"
          }
        }
      }
    },
    "Scrape Info": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Récupérer les infos"
          }
        }
      }
    },
    "Scrape Missing": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Récupérer les manquants"
          }
        }
      }
    },
    "Scrape info for the %lld games in this list missing it": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Scrape info for the game in this list missing it"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Scrape info for the %lld games in this list missing it"
                }
              }
            }
          }
        },
        "fr": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Récupérer les infos du jeu de cette liste qui n’en a pas"
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Récupérer les infos des %lld jeux de cette liste qui n’en ont pas"
                }
              }
            }
          }
        }
      }
    },
    "Scraping": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Récupération des infos"
          }
        }
      }
    },
    "Scraping %lld of %lld…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Scraping %1$lld of %2$lld…"
          }
        },
        "fr": {
