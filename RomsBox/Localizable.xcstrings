        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisir RetroArch.app…"
          }
        }
      }
    },
    "Choose a ROMs folder to get started. RomsBox recognizes libraries organized the way Batocera, RetroBat, or ES-DE organize them.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un dossier de ROM pour commencer. RomsBox reconnaît les bibliothèques organisées comme celles de Batocera, RetroBat ou ES-DE."
          }
        }
      }
    },
    "Choose an image or drag one onto the cover.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une image ou faites-en glisser une sur la jaquette."
          }
        }
      }
    },
    "Choose…": {
      "localizations": {
        "fr": {
