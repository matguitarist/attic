      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Par défaut"
          }
        }
      }
    },
    "Delete": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Supprimer"
          }
        }
