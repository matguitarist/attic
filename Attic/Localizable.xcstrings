        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Romset"
          }
        }
      }
    },
    "Romsets must match FinalBurn Neo's version (1.0.0.03). Sets from other versions or from another emulator may fail to load.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les romsets doivent correspondre à la version de FinalBurn Neo (1.0.0.03). Ceux d’autres versions ou d’un autre émulateur peuvent ne pas se charger."
          }
        }
      }
    },
    "Run-ahead hides the console’s own input lag; 1 frame suits most games.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le run-ahead masque la latence propre à la console ; 1 image convient à la plupart des jeux."
          }
        }
      }
    },
    "Running…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En cours…"
          }
        }
      }
    },
    "SHA-1": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "SHA-1"
          }
        }
      }
