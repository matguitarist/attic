    "Add to New Collection…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter à une nouvelle collection…"
          }
        }
      }
    },
    "Add your folder in Settings › General, then choose Rescan Library. Rescan again whenever you add or remove games.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez votre dossier dans Réglages › Général, puis choisissez Réanalyser la bibliothèque. Réanalysez chaque fois que vous ajoutez ou retirez des jeux."
          }
        }
      }
    },
    "Added automatically": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutés automatiquement"
          }
        }
      }
    },
    "Added by hand": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutés à la main"
          }
        }
      }
    },
