    "%@ connected": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ connectée"
          }
        }
      }
    },
    "%@ doesn't get smaller zipped, so it stays as it is.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ne prend pas moins de place compressé en ZIP, il reste tel quel."
          }
        }
      }
    },
    "%@ isn't a known dump": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’est pas un dump connu"
          }
        }
      }
    },
    "%@ to the Trash": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ vers la corbeille"
          }
        }
      }
    },
