    "Choose RetroArch.app…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisir RetroArch.app…"
          }
        }
      }
    },
    "Choose RetroBat's or Batocera's roms folder, or one system's folder in it.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez le dossier roms de RetroBat ou de Batocera, ou le dossier d’un système qu’il contient."
          }
        }
      }
    },
    "Choose a ROMs folder to get started. Attic recognizes libraries organized the way Batocera, RetroBat, or ES-DE organize them.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un dossier de ROM pour commencer. Attic reconnaît les bibliothèques organisées comme celles de Batocera, RetroBat ou ES-DE."
          }
        }
      }
    },
    "Choose an emulator for %@ first, in Settings › Emulators.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez d’abord un émulateur pour %@, dans Réglages › Émulateurs."
          }
        }
      }
    },
    "Choose an exported collection folder or its collection.json, or ES-DE custom collections (custom-Name.cfg, in ES-DE's collections folder).": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un dossier de collection exporté ou son collection.json, ou des collections personnalisées ES-DE (custom-Nom.cfg, dans le dossier collections d’ES-DE)."
          }
        }
      }
    },
    "Choose an image or drag one onto the cover.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une image ou faites-en glisser une sur la jaquette."
          }
        }
      }
    },
    "Choose games, or folders of games. They're filed in your ROMs folder with their covers and videos.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez des jeux, ou des dossiers de jeux. Ils sont rangés dans votre dossier de ROMs avec leurs jaquettes et vidéos."
          }
        }
      }
    },
    "Choose where Attic keeps backups of your saves. Another drive or a synced folder keeps them safest.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez où Attic garde les sauvegardes de vos parties. Un autre disque ou un dossier synchronisé les protège le mieux."
          }
        }
      }
    },
    "Choose…": {
      "localizations": {
        "fr": {
