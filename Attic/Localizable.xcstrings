      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout mettre à jour (%lld)"
          }
        }
      }
    },
    "Update available. Installed version built %@.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mise à jour disponible. Version installée compilée le %@."
          }
        }
      }
    },
    "Updated “%@”: %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Updated “%1$@”: %2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "« %@ » mis à jour : %@"
          }
        }
      }
