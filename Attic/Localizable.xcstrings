        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld jeux sur %2$lld systèmes"
          }
        }
      }
    },
    "%lld items, %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld items, %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld éléments, %2$@."
          }
        }
      }
    },
    "%lld items, %@: fan art, marquees, 3D boxes, mix images, title screens…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld items, %2$@: fan art, marquees, 3D boxes, mix images, title screens…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld éléments, %2$@ : fan art, marquees, boîtes 3D, mix images, écrans titres…"
          }
        }
      }
    },
    "%lld items, %@: folders for no system Attic knows, and empty gamelist folders.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld items, %2$@: folders for no system Attic knows, and empty gamelist folders."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld éléments, %2$@ : dossiers d’aucun système connu d’Attic, et dossiers de gamelist vides."
          }
        }
      }
    },
    "%lld items, %@: marquees, fan art and the like, once the rest has moved.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld items, %2$@: marquees, fan art and the like, once the rest has moved."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld éléments, %2$@ : marquees, fan art et autres, une fois le reste déplacé."
          }
        }
      }
    },
    "%lld items, %@: systeminfo.txt, spare gamelists, scraper leftovers.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld items, %2$@: systeminfo.txt, spare gamelists, scraper leftovers."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld éléments, %2$@ : systeminfo.txt, gamelists en trop, restes de scrapers."
          }
        }
      }
    },
    "%lld manuals redrawn at 150 dpi, kept only when that saves at least 40%%.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld manuels refaits à 150 dpi, gardés seulement s’ils font gagner au moins 40 %%."
          }
        }
      }
    },
