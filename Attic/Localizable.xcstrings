    },
    "Adding your own ScreenScraper member login raises your scrape quota and concurrent-thread limit.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter votre compte membre ScreenScraper augmente votre quota de requêtes et le nombre de requêtes simultanées."
          }
        }
      }
    },
    "After each library scan, for instance once you've added a system.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Après chaque analyse de la bibliothèque, par exemple une fois un système ajouté."
          }
        }
      }
    },
