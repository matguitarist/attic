    "Get an API key on thegamesdb.net": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtenir une clé d’API sur thegamesdb.net"
          }
        }
      }
    },
    "Getting Started": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Premiers pas"
          }
        }
      }
    },
    "Good dumps with file names of their own. Their media, gamelist entries and saves follow, and they keep their play history and collections.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De bons dumps avec leurs propres noms de fichiers. Leurs médias, entrées de gamelist et sauvegardes suivent, et ils gardent leur historique de jeu et leurs collections."
          }
        }
      }
    },
    "Hacks": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hacks"
          }
        }
      }
    },
    "Handheld LCD": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
