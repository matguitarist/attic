            "value": "1 image"
          }
        }
      }
    },
    "A Dolphin already in your Applications folder is used as is; otherwise Attic installs the latest release from dolphin-emu.org.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un Dolphin déjà présent dans votre dossier Applications est utilisé tel quel ; sinon Attic installe la dernière version depuis dolphin-emu.org."
          }
        }
      }
    },
    "A character or key art, above it in the side panel.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un personnage ou une illustration, au-dessus dans le panneau latéral."
          }
        }
      }
    },
    "A/B swapped in games": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "A/B inversés en jeu"
