    "ScreenScraper": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ScreenScraper"
          }
        }
      }
    },
    "ScreenScraper doesn't support this system yet.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ScreenScraper ne prend pas encore en charge ce système."
          }
        }
      }
    },
    "ScreenScraper isn't configured yet — add your devID/devPassword in Settings.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ScreenScraper n’est pas encore configuré — ajoutez votre devID/devPassword dans les Réglages."
          }
        }
      }
    },
    "ScreenScraper rejected the request (bad credentials or quota exceeded): %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "ScreenScraper a refusé la requête (identifiants incorrects ou quota dépassé) : %@"
          }
        }
      }
    },
    "ScreenScraper's API requires a devID/devPassword issued to registered client software — separate from your personal account. Request one on their developer forum, then paste it in below.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’API de ScreenScraper exige un devID/devPassword attribué aux logiciels clients enregistrés — distinct de votre compte personnel. Demandez-en un sur leur forum développeurs, puis collez-le ci-dessous."
          }
        }
      }
    },
    "Search": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recherche"
          }
        }
      }
    },
    "Search Games": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechercher des jeux"
          }
        }
      }
    },
    "Search Shaders": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechercher des shaders"
          }
        }
      }
    },
    "Select a Topic": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un sujet"
          }
        }
      }
    },
    "Select a game to see its details.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez un jeu pour voir ses détails."
          }
        }
      }
    },
    "Select inserts a coin, Start starts the game.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Select insère une pièce, Start lance la partie."
          }
        }
      }
    },
    "Select switches the disk side in most games.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Select change de face de disquette dans la plupart des jeux."
          }
        }
      }
    },
    "Separate several words with commas: a game is found when its title contains any of the first ones and none of the others.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Séparez plusieurs mots par des virgules : un jeu est trouvé si son titre contient l’un des premiers et aucun des autres."
          }
        }
      }
    },
    "Set Up All Systems": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurer tous les systèmes"
          }
        }
      }
    },
    "Set a default emulator for this system in Settings, or choose one from Launch With.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un émulateur par défaut pour ce système dans les Réglages, ou choisissez-en un dans « Lancer avec »."
          }
        }
      }
    },
    "Settings › Controller sets which button confirms: the bottom one (Xbox, PlayStation) or the right one (Nintendo, Switch). It applies to Attic, Cabinet Mode and RetroArch's menus.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglages › Manette choisit le bouton de validation : celui du bas (Xbox, PlayStation) ou celui de droite (Nintendo, Switch). Cela s’applique à Attic, au mode Cabinet et aux menus de RetroArch."
          }
        }
      }
    },
    "Shader Library…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bibliothèque de shaders…"
          }
        }
      }
    },
