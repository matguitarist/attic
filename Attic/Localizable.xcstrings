{
  "sourceLanguage": "en",
  "strings": {
    "": {},
    " (and %lld tracks)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " (et %lld pistes)"
          }
        }
      }
    },
    " (keeps %@)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " (garde %@)"
          }
        }
      }
    },
    " (or %lld other known dumps)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": " (ou %lld autres dumps connus)"
          }
        }
      }
    },
    "%@ (Recommended)": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ (recommandé)"
          }
        }
      }
    },
    "%@ Needs a BIOS": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ a besoin d’un BIOS"
          }
        }
