    "%lld files that aren't games for their system were left where they are.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld fichiers qui ne sont pas des jeux pour leur système sont restés à leur place."
          }
        }
      }
    },
    "%lld files, renamed ES-DE style (Game-boxart.png becomes covers/Game.png).": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld fichiers, renommés à la manière d’ES-DE (Jeu-boxart.png devient covers/Jeu.png)."
          }
        }
      }
    },
    "%lld frames": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld images"
          }
        }
      }
    },
    "%lld gamelists: Batocera's move to gamelists/, and old media paths and missing games come out.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld gamelists : celles de Batocera vont dans gamelists/, et les anciens chemins de médias et les jeux absents en sont retirés."
          }
        }
      }
    },
    "%lld games": {
      "localizations": {
