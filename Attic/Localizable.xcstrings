    "Install Failed": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de l’installation"
          }
        }
      }
    },
    "Install RetroArch": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installer RetroArch"
          }
        }
      }
    },
    "Install and choose emulators in Settings…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installer et choisir les émulateurs dans les Réglages…"
          }
        }
      }
    },
    "Install the PS Vita firmware once in Vita3K (PSVUPDAT.PUP and the font package, both from Sony's website).": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installez une fois le firmware PS Vita dans Vita3K (PSVUPDAT.PUP et le paquet de polices, tous deux sur le site de Sony)."
          }
        }
      }
    },
    "Install the PS3 system software once in RPCS3 (File › Install Firmware) with PS3UPDAT.PUP from Sony's website.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installez une fois le logiciel système PS3 dans RPCS3 (Fichier › Installer le firmware) avec PS3UPDAT.PUP depuis le site de Sony."
          }
        }
      }
    },
    "Install your games in Vita3K (.vpk, or .pkg with its license). With a psvita folder in your ROMs folder, Attic adds every installed game to the library by itself.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installez vos jeux dans Vita3K (.vpk, ou .pkg avec sa licence). Avec un dossier psvita dans votre dossier de ROMs, Attic ajoute de lui-même chaque jeu installé à la bibliothèque."
          }
        }
      }
    },
    "Installed": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installé"
          }
        }
      }
    },
    "Installed Cores": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cœurs installés"
          }
        }
      }
    },
    "Installed in the Emulation folder.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installé dans le dossier Emulation."
          }
        }
      }
    },
    "Installed — %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Installé — %@"
          }
        }
      }
    },
    "Installing %@…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
