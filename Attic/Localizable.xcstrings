      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Placez d’abord %@ dans le dossier BIOS ; sans lui, l’émulateur ne peut pas démarrer. Copiez les BIOS depuis du matériel qui vous appartient ; Attic ne les télécharge jamais."
          }
        }
      }
    },
