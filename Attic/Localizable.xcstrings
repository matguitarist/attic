        }
      }
    },
    "%lld games in your library": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld jeux dans votre bibliothèque"
          }
        }
      }
    },
    "%lld games moved to the Trash, %@. To bring one back, use Put Back in the Trash, then File › Refresh Library.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld games moved to the Trash, %2$@. To bring one back, use Put Back in the Trash, then File › Refresh Library."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld jeux placés dans la corbeille, %2$@. Pour en récupérer un, utilisez Remettre à sa place dans la corbeille, puis Fichier › Actualiser la bibliothèque."
          }
        }
      }
    },
    "%lld games on %lld systems": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld games on %2$lld systems"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld jeux sur %2$lld systèmes"
          }
        }
      }
    },
    "%lld games renamed, with their media, gamelist entries and saves.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld jeux renommés, avec leurs médias, leurs entrées de gamelist et leurs sauvegardes."
          }
        }
      }
    },
    "%lld games renamed, with their media, gamelist entries and saves. %lld kept their names: another file already has the new one.": {
      "extractionState": "stale",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld games renamed, with their media, gamelist entries and saves. %2$lld kept their names: another file already has the new one."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld jeux renommés, avec leurs médias, leurs entrées de gamelist et leurs sauvegardes. %2$lld ont gardé leur nom : un autre fichier porte déjà le nouveau."
          }
        }
      }
    },
