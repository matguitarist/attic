    "Check for updates automatically": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rechercher les mises à jour automatiquement"
          }
        }
      }
    },
    "Checks this system's games against No-Intro's lists of known good dumps.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie les jeux de ce système d’après les listes de bons dumps de No-Intro."
          }
        }
      }
    },
    "Checks this system's sets against its emulator's DAT, and shows what's missing.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie les jeux de ce système avec le DAT de leur émulateur, et montre ce qui manque."
          }
        }
      }
    },
    "Checks your games against No-Intro's lists of known good dumps.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifie vos jeux d’après les listes de bons dumps de No-Intro."
          }
        }
      }
    },
    "Chips or a disc image are missing: the game may not start.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il manque des puces ou une image disque : le jeu risque de ne pas démarrer."
          }
        }
      }
    },
    "Chips or a disc image are missing: the game may not start. Tools › Verify Games says which.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il manque des puces ou une image disque : le jeu risque de ne pas démarrer. Outils › Vérifier les jeux dit lesquelles."
          }
        }
      }
    },
