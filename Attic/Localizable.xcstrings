            "state": "translated",
            "value": "Noms et illustrations"
          }
        }
      }
    },
    "Names that would add a release tag such as (Proto) or (Virtual Console) aren't ticked: No-Intro sometimes lists the same data under several releases.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les noms qui ajouteraient une mention de version comme (Proto) ou (Virtual Console) ne sont pas cochés : No-Intro liste parfois les mêmes données sous plusieurs versions."
          }
        }
      }
    },
