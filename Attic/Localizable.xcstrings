      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ — Recommandé"
          }
        }
      }
    },
    "%@, %@, in %@. The newest %lld backups are kept.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@, %2$@, in %3$@. The newest %4$lld backups are kept."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@, %2$@, dans %3$@. Les %4$lld sauvegardes les plus récentes sont gardées."
          }
        }
      }
    },
    "%@, %lld%% of %@": {
      "localizations": {
        "en": {
          "stringUnit": {
