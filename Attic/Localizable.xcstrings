    },
    "Use %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliser %@"
          }
        }
      }
    },
    "Use .adf disks, or .lha/WHDLoad packs for hard-disk installs.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez des disquettes .adf, ou des paquets .lha/WHDLoad pour les installations sur disque dur."
          }
        }
      }
    },
    "Use .chd or .cue/.bin dumps. The Neo Geo CD BIOS goes in a neocd folder inside the BIOS folder.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez des dumps .chd ou .cue/.bin. Le BIOS Neo Geo CD va dans un dossier neocd à l’intérieur du dossier BIOS."
          }
        }
      }
    },
    "Use .iso or .cso dumps. Attic also installs PPSSPP's support files (fonts and data) into the BIOS folder.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez des dumps .iso ou .cso. Attic installe aussi les fichiers de PPSSPP (polices et données) dans le dossier BIOS."
          }
        }
      }
    },
    "Use .wua files (Cemu's compressed format), or .wud/.wux disc images.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez des fichiers .wua (format compressé de Cemu), ou des images disque .wud/.wux."
          }
        }
      }
    },
    "Use It": {
      "localizations": {
