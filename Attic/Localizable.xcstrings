      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter des jeux…"
          }
        }
      }
    },
    "Add a devID/devPassword to enable scraping.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un devID/devPassword pour activer la récupération des infos."
          }
        }
      }
    },
    "Add a standalone emulator to launch specific systems or games with instead of RetroArch.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez un émulateur autonome pour lancer certains systèmes ou jeux à la place de RetroArch."
          }
        }
      }
    },
    "Add an API key to enable scraping.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez une clé d’API pour activer la récupération des infos."
          }
        }
      }
    },
    "Add credentials in Settings › ScreenScraper or TheGamesDB, then use Scrape Missing in the toolbar, or Scrape Info on a single game.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez vos identifiants dans Réglages › ScreenScraper ou TheGamesDB, puis utilisez Récupérer les manquants dans la barre d’outils, ou Récupérer les infos sur un seul jeu."
          }
        }
      }
    },
    "Add new matching games automatically": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter automatiquement les nouveaux jeux qui correspondent"
          }
        }
      }
    },
    "Add to / remove from Favorites": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter aux favoris / retirer des favoris"
          }
        }
      }
    },
    "Add to Collection": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajouter à une collection"
