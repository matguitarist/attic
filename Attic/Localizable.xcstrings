    "%lld games, %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld games, %2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld jeux, %2$@"
          }
        }
      }
    },
    "%lld games, %@ now. Each becomes a .zip of its own, kept only when it saves at least 10%%. Attic unzips a game when it starts.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld games, %2$@ now. Each becomes a .zip of its own, kept only when it saves at least 10%%. Attic unzips a game when it starts."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld jeux, %2$@ actuellement. Chacun devient son propre .zip, gardé seulement s’il fait gagner au moins 10 %%. Attic décompresse un jeu au lancement."
          }
        }
      }
    },
    "%lld games, %@ now. Each disc becomes one .chd, usually 30–60%% smaller; PSP and PS2 discs too. Takes a few minutes per game.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld games, %2$@ now. Each disc becomes one .chd, usually 30–60%% smaller; PSP and PS2 discs too. Takes a few minutes per game."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld jeux, %2$@ actuellement. Chaque disque devient un seul .chd, en général 30 à 60 %% plus léger ; disques PSP et PS2 compris. Compte quelques minutes par jeu."
          }
        }
      }
    },
    "%lld installed in Vita3K; its games are now in PS Vita.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld installés dans Vita3K ; ses jeux sont maintenant dans PS Vita."
          }
        }
      }
    },
    "%lld items, %@.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld items, %2$@."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld éléments, %2$@."
          }
        }
      }
    },
    "%lld items, %@: fan art, marquees, 3D boxes, mix images, title screens…": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld items, %2$@: fan art, marquees, 3D boxes, mix images, title screens…"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld éléments, %2$@ : fan art, marquees, boîtes 3D, mix images, écrans titres…"
          }
        }
      }
    },
    "%lld items, %@: folders for no system Attic knows, and empty gamelist folders.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld items, %2$@: folders for no system Attic knows, and empty gamelist folders."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld éléments, %2$@ : dossiers d’aucun système connu d’Attic, et dossiers de gamelist vides."
          }
        }
      }
    },
    "%lld items, %@: marquees, fan art and the like, once the rest has moved.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld items, %2$@: marquees, fan art and the like, once the rest has moved."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld éléments, %2$@ : marquees, fan art et autres, une fois le reste déplacé."
          }
        }
      }
    },
    "%lld items, %@: other regions, revisions and betas of games you have, with their media. The kept copy is a finished release: World, then USA, Europe, Japan, then the latest revision. Your games themselves, so it's off unless you tick it.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld items, %2$@: other regions, revisions and betas of games you have, with their media. The kept copy is a finished release: World, then USA, Europe, Japan, then the latest revision. Your games themselves, so it's off unless you tick it."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld éléments, %2$@ : autres régions, révisions et bêtas de jeux que vous avez, avec leurs médias. La copie gardée est une version finale : World, puis USA, Europe, Japon, puis la dernière révision. Ce sont vos jeux, donc c’est décoché sauf si vous le cochez."
          }
        }
      }
    },
    "%lld items, %@: systeminfo.txt, spare gamelists, scraper leftovers.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "%1$lld items, %2$@: systeminfo.txt, spare gamelists, scraper leftovers."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld éléments, %2$@ : systeminfo.txt, gamelists en trop, restes de scrapers."
          }
        }
      }
    },
    "%lld kept their names: another file already has the new one, with other data.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld ont gardé leur nom : un autre fichier porte déjà le nouveau, avec d'autres données."
