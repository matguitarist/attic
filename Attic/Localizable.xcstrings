        }
      }
    },
    "Select a game to see its details.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sélectionnez un jeu pour voir ses détails."
          }
        }
      }
    },
    "Select inserts a coin, Start starts the game.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Select insère une pièce, Start lance la partie."
          }
        }
      }
    },
    "Select switches the disk side in most games.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Select change de face de disquette dans la plupart des jeux."
          }
        }
      }
    },
    "Separate several words with commas: a game is found when its title contains any of the first ones and none of the others. Leave them empty to choose by genre, players or years below.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Séparez plusieurs mots par des virgules : un jeu est trouvé quand son titre contient l’un des premiers et aucun des autres. Laissez vide pour choisir par genre, joueurs ou années ci-dessous."
          }
        }
      }
    },
    "Set Up All Systems": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurer tous les systèmes"
          }
        }
      }
    },
    "Set a default emulator for this system in Settings, or choose one from Launch With.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez un émulateur par défaut pour ce système dans les Réglages, ou choisissez-en un dans « Lancer avec »."
          }
        }
      }
    },
    "Sets the emulator's version doesn't know by that name.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeux que la version de l'émulateur ne connaît pas sous ce nom."
          }
        }
      }
    },
    "Sets with chips from another emulator version.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeux avec des puces d'une autre version de l'émulateur."
          }
        }
      }
    },
    "Settings › Controller sets which button confirms: the bottom one (Xbox, PlayStation) or the right one (Nintendo, Switch). It applies to Attic, Cabinet Mode and RetroArch's menus.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Réglages › Manette choisit le bouton de validation : celui du bas (Xbox, PlayStation) ou celui de droite (Nintendo, Switch). Cela s’applique à Attic, au mode Cabinet et aux menus de RetroArch."
          }
        }
      }
    },
    "Shader Library…": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bibliothèque de shaders…"
          }
        }
      }
    },
