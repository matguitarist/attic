{
  "sourceLanguage": "en",
  "strings": {
    "Accurate ColecoVision core.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cœur ColecoVision précis."
          }
        }
      }
    },
    "Accurate Commodore 64.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Commodore 64 précis."
          }
        }
      }
    },
    "Accurate DS and DSi, no BIOS needed.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "DS et DSi précis, sans BIOS."
