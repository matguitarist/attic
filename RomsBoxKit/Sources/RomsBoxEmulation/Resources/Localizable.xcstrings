        }
      }
    },
    "Accurate and fast — the usual choice.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Précis et rapide — le choix habituel."
          }
        }
      }
    },
    "Accurate and light — the usual Game Boy choice.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Précis et léger — le choix habituel pour le Game Boy."
          }
        }
      }
    },
    "Accurate and lighter.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Précis et plus léger."
          }
        }
      }
    },
    "Also runs ColecoVision.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fait aussi tourner la ColecoVision."
          }
        }
      }
    },
    "Alternative N64 core.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cœur N64 alternatif."
          }
        }
      }
    },
    "Amiga 500 to 1200, CD32 and CDTV.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De l’Amiga 500 au 1200, CD32 et CDTV."
          }
        }
      }
    },
    "Atari 400/800, XL and XE.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Atari 400/800, XL et XE."
          }
        }
      }
    },
    "Atari 8-bit family including 5200.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Famille Atari 8 bits, 5200 compris."
          }
        }
      }
    },
    "Best compatibility, with upscaling.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Meilleure compatibilité, avec mise à l’échelle."
          }
        }
      }
    },
    "Citra's actively developed successor.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le successeur de Citra, activement développé."
          }
        }
      }
    },
    "Couldn't find the latest %@ release for macOS.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de trouver la dernière version de %@ pour macOS."
          }
        }
      }
    },
    "Couldn't find the latest RetroArch release on libretro's site.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de trouver la dernière version de RetroArch sur le site de libretro."
          }
        }
      }
    },
    "Couldn't unpack the download: %@": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de décompresser le téléchargement : %@"
          }
        }
      }
    },
    "Current MAME; needs romsets from the same MAME version.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "MAME actuel ; demande des romsets de la même version de MAME."
          }
        }
      }
    },
    "Cycle-accurate; heavier.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Précis au cycle près ; plus exigeant."
          }
        }
      }
    },
    "Dedicated 5200 core.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cœur dédié à la 5200."
          }
        }
      }
    },
    "Dedicated SuperGrafx core.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cœur dédié à la SuperGrafx."
          }
        }
      }
    },
    "Dolphin as a RetroArch core; the standalone app is more complete.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dolphin en cœur RetroArch ; l’app autonome est plus complète."
          }
        }
      }
    },
    "Download failed (HTTP %lld): %@": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "new",
            "value": "Download failed (HTTP %1$lld): %2$@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec du téléchargement (HTTP %lld) : %@"
          }
        }
      }
    },
    "Dreamcast, NAOMI and Atomiswave, with upscaling.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dreamcast, NAOMI et Atomiswave, avec mise à l’échelle."
          }
        }
      }
    },
    "DuckStation's engine as a RetroArch core.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le moteur de DuckStation en cœur RetroArch."
          }
        }
      }
    },
    "Famicom Disk System support built in.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prise en charge intégrée du Famicom Disk System."
