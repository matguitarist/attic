    "Accurate Neo Geo Pocket and Pocket Color.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Neo Geo Pocket et Pocket Color précis."
          }
        }
      }
    },
    "Accurate PC Engine, CD and SuperGrafx.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "PC Engine, CD et SuperGrafx avec précision."
