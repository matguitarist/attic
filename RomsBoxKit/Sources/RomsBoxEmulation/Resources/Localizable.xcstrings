        }
      }
    },
    "Fast, broad mapper support.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapide, large prise en charge des mappers."
          }
        }
      }
    },
    "Fast, with Super Game Boy support.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapide, avec prise en charge du Super Game Boy."
          }
        }
      }
    },
    "Fast; can run without a BIOS.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapide ; fonctionne sans BIOS."
          }
        }
      }
    },
    "Fast; the only option with 32X support.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rapide ; la seule option qui gère la 32X."
          }
        }
      }
    },
    "Faster, less accurate.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Plus rapide, moins précis."
          }
        }
      }
    },
    "Highly accurate Sega 8/16-bit and Sega CD.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sega 8/16 bits et Sega CD avec une grande précision."
