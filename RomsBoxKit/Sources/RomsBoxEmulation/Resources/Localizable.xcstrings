    },
    "Accurate WonderSwan and WonderSwan Color.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "WonderSwan et WonderSwan Color précis."
          }
        }
      }
    },
    "Accurate and fast — the standard GBA core.": {
      "localizations": {
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Précis et rapide — le cœur GBA de référence."
